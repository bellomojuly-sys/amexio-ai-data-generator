# Copy to .env.local (never commit it) to choose your own model for `npm run dev`.
# The hosted Claude page ignores all of this.

# anthropic | openai | offline
VITE_MODEL_PROVIDER=offline

# Anthropic:  VITE_MODEL_API_KEY=sk-ant-...   VITE_MODEL_NAME=claude-sonnet-5-5
# Ollama:     VITE_MODEL_PROVIDER=openai  VITE_MODEL_BASE_URL=http://localhost:11434/v1  VITE_MODEL_NAME=llama3.1
# OpenAI:     VITE_MODEL_PROVIDER=openai  VITE_MODEL_BASE_URL=https://api.openai.com/v1  VITE_MODEL_API_KEY=sk-...  VITE_MODEL_NAME=gpt-4o-mini
VITE_MODEL_API_KEY=
VITE_MODEL_NAME=
VITE_MODEL_BASE_URL=
