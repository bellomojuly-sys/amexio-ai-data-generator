{
  "$comment": "Pipeline contract v1.1. Generated by python3 -m pipeline.schema; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One line per LLM call and per code step. Snake_case, as in the contract.",
  "properties": {
    "cost_eur": {
      "anyOf": [
        {
