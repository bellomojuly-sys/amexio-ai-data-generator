        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "kind": {
      "enum": [
        "llm",
        "code"
      ],
      "title": "Kind",
      "type": "string"
    },
    "model": {
      "anyOf": [
