  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "AX-010 — one object that holds all the parts of a dossier.\n\nBuilding a Case validates every part and the links between them in a\nsingle call: each part is filed under its own well-formed ID, every job\nand event points at a persona or organisation the Case holds, every\ndocument points at an event the Case holds, and the events tell a\npossible story.",
  "properties": {
    "case_number": {
      "title": "Case Number",
      "type": "string"
    },
    "documents": {
      "additionalProperties": {
        "$ref": "#/$defs/Document"
      },
      "title": "Documents",
      "type": "object"
    },
    "dossier": {
      "$ref": "#/$defs/Dossier"
    },
    "employments": {
      "items": {
        "$ref": "#/$defs/Employment"
      },
      "title": "Employments",
      "type": "array"
    },
    "events": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "absence": "#/$defs/AbsenceEvent",
            "appraisal": "#/$defs/AppraisalEvent",
            "contract_change": "#/$defs/ContractChangeEvent",
            "hire": "#/$defs/HireEvent",
            "medical_check": "#/$defs/MedicalCheckEvent",
            "termination": "#/$defs/TerminationEvent",
            "training": "#/$defs/TrainingEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/HireEvent"
          },
          {
            "$ref": "#/$defs/ContractChangeEvent"
          },
          {
            "$ref": "#/$defs/TrainingEvent"
          },
          {
            "$ref": "#/$defs/AppraisalEvent"
          },
          {
            "$ref": "#/$defs/MedicalCheckEvent"
          },
          {
            "$ref": "#/$defs/AbsenceEvent"
          },
          {
            "$ref": "#/$defs/TerminationEvent"
          }
        ]
      },
      "title": "Events",
      "type": "object"
    },
    "organisations": {
      "additionalProperties": {
        "$ref": "#/$defs/Organisation"
      },
      "title": "Organisations",
      "type": "object"
    },
    "personas": {
      "additionalProperties": {
        "$ref": "#/$defs/Persona"
      },
      "title": "Personas",
      "type": "object"
    }
  },
  "required": [
    "case_number",
    "dossier"
  ],
  "title": "Case",
  "type": "object"
}
